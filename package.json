{
  "name": "clone-tabnews",
  "version": "1.0.0",
  "description": "tabnews.com.br clone for study. check it out!",
  "main": "index.js",
  "scripts": {
    "dev": "yarn services:up && next dev",
    "services:up": "docker-compose -f infra/compose.yaml up -d",
    "services:down": "docker-compose -f infra/compose.yaml down",
    "services:stop": "docker-compose -f infra/compose.yaml stop",
    "build": "next build",
    "start": "next start",
    "lint:check": "prettier --check .",
    "lint:fix": "prettier --write .",
    "test": "jest",
    "test:watch": "jest --watchAll"
  },
  "author": "marcos lott <lott.marcos@gmail.com>",
  "license": "MIT",
  "dependencies": {
    "@types/pg": "^8.11.10",
    "next": "^13.1.6",
    "pg": "8.11.3",
    "react": "18.2.0",
    "react-dom": "18.2.0"
  },
  "repository": "git@github.com:lottmarcos/clone-tabnews.git",
  "private": false,
  "devDependencies": {
    "@types/jest": "^29.5.14",
    "@types/node": "22.6.1",
    "@types/react": "18.3.8",
    "jest": "^29.7.0",
    "prettier": "^3.3.3",
    "ts-jest": "^29.2.5",
    "typescript": "5.6.2"
  },
  "engines": {
    "node": ">=20.0.0",
    "npm": ">=8.0.0",
    "yarn": ">=1.22.22"
  }
}
